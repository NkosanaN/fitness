# ExerciseDB V2 / AscendAPI — free OSS tier (https://oss.exercisedb.dev)
# No API key required. Each exercise includes an animated GIF demo (gifUrl).
#
# OPTIONAL: The paid RapidAPI tier "EDB with Videos and Images by AscendAPI"
# adds mp4 videoUrl + multi-res images. To switch, set the three lines:
#   EXPO_PUBLIC_EXERCISEDB_BASE_URL=https://edb-with-videos-and-images-by-ascendapi.p.rapidapi.com/api/v1
#   EXPO_PUBLIC_EXERCISEDB_API_KEY=your_rapidapi_key_here
#   EXPO_PUBLIC_EXERCISEDB_API_HOST=edb-with-videos-and-images-by-ascendapi.p.rapidapi.com
EXPO_PUBLIC_EXERCISEDB_BASE_URL=https://oss.exercisedb.dev/api/v1

# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_APP_ENV=development